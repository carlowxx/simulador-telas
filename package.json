{
  "name": "simulador-telas",
  "productName": "Simulador de Telas",
  "version": "2.4.0",
  "description": "Simula telas, canaletas e marcações sobre fotos de vistoria e exporta PNG.",
  "main": "main.js",
  "author": "carlowxx",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/carlowxx/simulador-telas.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never && node scripts/pin-exe.js",
    "instalar": "powershell -ExecutionPolicy Bypass -File scripts/instalar.ps1",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.carlowxx.simuladortelas",
    "productName": "Simulador de Telas",
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Simulador-de-Telas-${version}-win.${ext}"
    }
  }
}
